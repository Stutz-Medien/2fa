<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="WordPress Theme Coding Standards" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<!-- See https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki/Annotated-Ruleset -->
	<!-- See https://github.com/WordPress/WordPress-Coding-Standards -->
	<!-- See https://github.com/WordPress/WordPress-Coding-Standards/wiki -->
	<!-- See https://github.com/PHPCompatibility/PHPCompatibility -->

	<exclude-pattern>node_modules</exclude-pattern>
	<exclude-pattern>vendor</exclude-pattern>
	<exclude-pattern>bin</exclude-pattern>
	<exclude-pattern>tests/</exclude-pattern>
	<exclude-pattern>acf-json</exclude-pattern>
	<exclude-pattern>wp-config.sample.php</exclude-pattern>
	<exclude-pattern>assets</exclude-pattern>

	<!-- Set a description for this ruleset. -->
	<description>A custom set of code standard rules to check for WordPress themes.</description>

	<!-- Pass some flags to PHPCS:
		 p flag: Show progress of the run.
		 s flag: Show sniff codes in all reports.
	-->
	<arg value="ps"/>

	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="./"/>

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>

	<!-- Only check the PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Use colors in output. -->
	<arg name="colors"/>

	<!-- Check all files in this directory and the directories below it. -->
	<file>.</file>

	<!-- Include the WordPress-Extra standard. -->
	<rule ref="WordPress-Extra">
		<!-- Allow short array syntax. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
		
		<!-- Allow modern block registration functions. -->
		<exclude name="WPThemeReview.PluginTerritory.ForbiddenFunctions.editor_blocks_register_block_style"/>
		<exclude name="WPThemeReview.PluginTerritory.ForbiddenFunctions.editor_blocks_register_block_pattern"/>
		<exclude name="WPThemeReview.PluginTerritory.ForbiddenFunctions.editor_blocks_register_block_pattern_category"/>
		
		<!-- Modern PHP allows closures. -->
		<exclude name="PHPCompatibility.FunctionDeclarations.NewClosure.Found"/>
		
		<!-- We use PSR-4 autoloading. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		
		<!-- Relaxed commenting requirements. -->
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingReturnType"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		
		<!-- Deprecated in PHPCS 4.0. -->
		<exclude name="Generic.Functions.CallTimePassByReference"/>

		<!-- Allow inline control structures (single-line without braces). -->
		<exclude name="Generic.ControlStructures.InlineControlStructure"/>
	</rule>

	<!-- Include the WordPress-Docs standard for better documentation. -->
	<rule ref="WordPress-Docs"/>

	<!-- Verify that the text_domain is set to the desired text-domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="andromeda-2fa"/>
			</property>
		</properties>
	</rule>

	<!-- Enforce PHP 8.4 compatibility. -->
	<config name="testVersion" value="8.4-"/>
	<rule ref="PHPCompatibility">
		<!-- Exclude PHP 8+ features we're intentionally using. -->
		<exclude name="PHPCompatibility.FunctionDeclarations.NewClosure.Found"/>
		<exclude name="PHPCompatibility.FunctionUse.NewFunctions.str_containsFound"/>
		<exclude name="PHPCompatibility.FunctionUse.NewFunctions.str_starts_withFound"/>
		<exclude name="PHPCompatibility.FunctionUse.NewFunctions.str_ends_withFound"/>
	</rule>
	
	<!-- Relax some rules for inc/ directory. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/inc/*</exclude-pattern>
	</rule>
</ruleset>