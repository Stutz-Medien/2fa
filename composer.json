{
    "name": "stutzmedien/2fa",
    "type": "wordpress-plugin",
    "description": "Authenticator compatible 2FA for WordPress",
    "version": "26.0.1",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Andrin Haldner",
            "homepage": "https://github.com/AHaldner"
        }
    ],
    "autoload": {
        "psr-4": {
            "Andromeda\\TwoFactorAuth\\": "inc/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andromeda\\TwoFactorAuth\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "alpha",
    "require": {
        "spomky-labs/otphp": "^11.3",
        "endroid/qr-code": "^6.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpunit/phpunit": "^9.6",
        "mockery/mockery": "^1.6",
        "brain/monkey": "^2.6"
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml",
        "lint:fix": "phpcbf --standard=phpcs.xml",
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
